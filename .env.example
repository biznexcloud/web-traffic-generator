TARGET_URL=https://restromandu.com
THREADS=41
PORT=5000
PROXY_ROTATE_INTERVAL=1800
OUTPUT_FOLDER=SEO_BOOSTER_2025
DWELL_MIN=90
DWELL_MAX=300
INTERNAL_DWELL_MIN=45
INTERNAL_DWELL_MAX=120
GOOGLE_WAIT_MIN=10
GOOGLE_WAIT_MAX=30
RETURNING_USER_RATIO=0.25
MAX_RETURNING_POOL_SIZE=2000
KEY_EVENT_PROBABILITY=0.15
PAGES_PER_SESSION_MIN=3
PAGES_PER_SESSION_MAX=6

# ===== RESIDENTIAL PROXY CONFIGURATION (REQUIRED FOR GA4 ACCEPTANCE) =====
# Free datacenter proxies are blocked by GA4 - you MUST configure residential proxies
# Option 1: Comma-separated list of authenticated residential proxies
# PREMIUM_PROXIES=http://user:pass@brd.superproxy.io:22225,http://user:pass@pr.oxylabs.io:7777

# Option 2: Provider-specific credentials (bot auto-configures endpoints)
# Bright Data (brightdata.com) - Residential
# BRIGHTDATA_API=your_username
# BRIGHTDATA_PASSWORD=your_password
# BRIGHTDATA_ZONE=residential

# Oxylabs (oxylabs.io) - Residential
# OXYLABS_USER=your_username
# OXYLABS_PASS=your_password

# Smartproxy (smartproxy.com) - Residential
# SMARTPROXY_USER=your_username
# SMARTPROXY_PASS=your_password

# Webshare (webshare.io) - API URL returning proxy list
# WEBSHARE_PROXY_LIST=https://proxy.webshare.io/api/v2/proxy/list/?mode=direct&page=1&page_size=100

# Geonode (geonode.com) - API key
# GEONODE_API_KEY=your_api_key

# Optional overrides (uncomment if needed)
# ADMIN_USER=admin
# ADMIN_PASS=
# KEYWORDS=restromandu,restaurant software nepal,restaurant POS nepal
